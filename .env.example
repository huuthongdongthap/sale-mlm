# Hive Warfare Academy — Environment Variables
# Copy this file to .env and fill in real values for production

# JWT signing secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=dev-only-change-in-production-32bytes!!

# AES-256 encryption key for PII (phone, email)
# Must be exactly 32 bytes (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=dev-only-change-in-production-32bytes!!

# PBKDF2 salt for password hashing
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
PASSWORD_SALT=dev-only-pbkdf2-salt!!

# Anthropic API key (for AI Coach sessions)
ANTHROPIC_API_KEY=sk-ant-...

# Zalo OA webhook secret
ZALO_WEBHOOK_SECRET=

# Cloudflare
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Sentry DSN (error reporting)
SENTRY_DSN=

# Environment
NODE_ENV=production
PORT=3000
