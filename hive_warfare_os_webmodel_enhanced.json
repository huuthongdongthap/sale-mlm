  "computed_metrics": {
    "weekly_score_calc": {
      "formula": "weekly_score = (5am?1:0)+(kaizen?1:0)+(zoom?1:0)+(learning?1:0)+(avg_connect_per_day>=15?1:0)+(follow_up_per_day>=3?1:0)",
      "type": "integer",
      "range": "0..6"
    },
    "conversion_pct_calc": {
      "formula": "conversion_pct = new_leads>0 ? (orders/new_leads*100) : 0",
      "type": "percent"
    },
    "kpi_score_calc": {
      "formula": "kpi_score = config.kpi_weights.habit_weight*(weekly_score/config.thresholds.habit_weekly_target*100) + config.kpi_weights.conversion_weight*conversion_pct + config.kpi_weights.revenue_weight*(revenue/1000000)",
      "notes": "revenue scaled by 1M VND"
    },
    "psn_score": {
      "formula": "psn_score = AVG(kpi_score WHERE member.psn == psn_id)"
    },
    "retention_risk_logic": {
      "formula": "risk = (energy_score < config.thresholds.retention_energy_low OR habit_count_7d < config.thresholds.retention_habit_low) ? 'High' : (energy_score < (config.thresholds.retention_energy_low+10) ? 'Medium' : 'Low')"
    }
  },
  "alerts_rules": [
    {
      "id": "ALERT_001",
      "name": "Conversion Low",
      "trigger": "conversion_pct < config.thresholds.conversion_alert_pct",
      "severity": "high",
      "action": [
        "notify_leader",
        "add_to_watchlist"
      ]
    },
    {
      "id": "ALERT_002",
      "name": "Lead Drop",
      "trigger": "weekly_new_leads_total < config.thresholds.lead_drop_threshold_weekly",
      "severity": "medium",
      "action": [
        "trigger_campaign('MiniBoost')",
        "notify_core_leaders"
      ]
    },
    {
      "id": "ALERT_003",
      "name": "Habit Drop Member",
      "trigger": "weekly_score < config.thresholds.habit_min_active",
      "severity": "high",
      "action": [
        "assign_buddy(member_id)",
        "schedule_1to1(member_id)"
      ]
    },
    {
      "id": "ALERT_004",
      "name": "PSN Weak",
      "trigger": "avg_habit_score < config.thresholds.psn_avg_habit_low OR status == 'At Risk'",
      "severity": "high",
      "action": [
        "escalate_to_core_leader(psn_id)",
        "deploy_coaching_pack(psn_id)"
      ]
    },
    {
      "id": "ALERT_005",
      "name": "Retention High Risk",
      "trigger": "risk_level == 'High'",
      "severity": "critical",
      "action": [
        "immediate_1to1(member_id)",
        "create_retention_ticket(member_id)"
      ]
    },
    {
      "id": "ALERT_006",
      "name": "Quadrant II Neglect",
      "trigger": "percent_tasks_q2_completed < 40",
      "severity": "high",
      "action": [
        "block_time_for_q2",
        "notify_leader"
      ]
    }
  ],
