  "workflows": {
    "weekly_sync": {
      "trigger": "cron 0 6 * * MON",
      "steps": [
        "aggregate weekly habit scores for last Monday",
        "aggregate weekly KPI (leads,orders,revenue)",
        "compute kpi_score for each member",
        "update psn summary (avg habit, orders, revenue)",
        "evaluate alerts (run alerts_rules)",
        "send summary email to core leaders with top signals"
      ]
    },
    "retention_watch": {
      "trigger": "on retention_monitor insert OR weekly_sync",
      "steps": [
        "if risk_level == 'High' then create immediate ticket and schedule 1:1 within 24h",
        "if risk_level == 'Medium' then assign buddy and schedule coaching within 72h",
        "log action and update member.status"
      ]
    },
    "campaign_boost": {
      "trigger": "alert ALRET_002 Lead Drop OR manual by lead",
      "steps": [
        "create 7-day Mini Boost campaign template",
        "assign PSN targets and daily tasks",
        "track campaign progress daily and show in dashboard",
        "post-campaign analysis"
      ]
    }
  },
  "implementation_notes": {
    "backend_recommendation": "Node.js + Express or Firebase Cloud Functions. Use Postgres or Firestore. Scheduled jobs via cron (Cloud Functions or Cloud Run).",
    "frontend_recommendation": "React (Vite) + Tailwind; Recharts or Chart.js for charts; TanStack Table for tables.",
    "security": "Role-based access: admin/core_leader/psn_leader/member; audit logs for actions.",
    "scalability": "Design to support 2000+ members; use paginated endpoints for lists."
  }
